#include <stdio.h>

#define MAX 5

struct Patient {
    char name[20];
    int priority; // Higher number = Higher priority
} queue[MAX];

int count = 0;

void insert() {
    if (count < MAX) {
        printf("Enter name and priority: ");
        scanf("%s %d", queue[count].name, &queue[count].priority);
        count++;
    } else {
        printf("Ward Full!\n");
    }
}

void treat_patient() {
    if (count == 0) {
        printf("No patients!\n");
        return;
    }

    // Find the patient with the highest priority
    int highest = 0;
    for (int i = 1; i < count; i++) {
        if (queue[i].priority > queue[highest].priority)
            highest = i;
    }

    printf(">> Treating: %s (P:%d)\n", queue[highest].name, queue[highest].priority);

    // Fast-delete: Move the last patient into the treated patient's slot
    queue[highest] = queue[count - 1];
    count--;
}

void display() {
    if (count == 0) printf("Queue Empty.\n");
    for (int i = 0; i < count; i++) {
        printf("%s(P:%d) ", queue[i].name, queue[i].priority);
    }
    printf("\n");
}

int main() {
    int choice;
    while (1) {
        printf("\n1.Insert 2.Treat 3.Display 4.Exit\nChoice: ");
        scanf("%d", &choice);
        
        if (choice == 1) insert();
        else if (choice == 2) treat_patient();
        else if (choice == 3) display();
        else break;
    }
    return 0;
}
