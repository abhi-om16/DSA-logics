#include <stdio.h>

#define MAX 5

struct Element {
    int data;
    int priority;
};

struct Element pq[MAX];
int size = 0;

void enqueue(int data, int priority) {
    if (size == MAX) {
        printf("Queue Overflow!\n");
        return;
    }

    int i = size - 1;
    while (i >= 0 && pq[i].priority < priority) {
        pq[i + 1] = pq[i];
        i--;
    }

    pq[i + 1].data = data;
    pq[i + 1].priority = priority;
    size++;
}

void dequeue() {
    if (size == 0) {
        printf("Queue Underflow!\n");
        return;
    }

    printf("Removed: %d (Priority: %d)\n", pq[0].data, pq[0].priority);

    for (int i = 0; i < size - 1; i++) {
        pq[i] = pq[i + 1];
    }
    size--;
}

void display() {
    if (size == 0) {
        printf("Queue is empty.\n");
        return;
    }

    for (int i = 0; i < size; i++) {
        printf("[%d | P:%d] ", pq[i].data, pq[i].priority);
    }
    printf("\n");
}

int main() {
    enqueue(10, 1);
    enqueue(30, 3);
    enqueue(20, 2);

    printf("Priority Queue: ");
    display();

    dequeue();

    printf("After Dequeue: ");
    display();

    return 0;
}
