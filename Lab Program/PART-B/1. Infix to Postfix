 #include <stdio.h>
#include <ctype.h>

// Function to return operator priority
int prec(char c) {
    if (c == '^') return 3;
    if (c == '*' || c == '/' || c == '%') return 2;
    if (c == '+' || c == '-') return 1;
    return 0;
}

int main() {
    char infix[100], stack[100];
    int top = -1;

    printf("Enter Infix: ");
    scanf("%s", infix);

    printf("Postfix: ");
    for (int i = 0; infix[i] != '\0'; i++) {
        char ch = infix[i];

        if (isalnum(ch)) {
            printf("%c", ch); // Print operands immediately
        } else if (ch == '(') {
            stack[++top] = ch; // Push open bracket
        } else if (ch == ')') {
            while (top != -1 && stack[top] != '(') 
                printf("%c", stack[top--]); // Pop until '('
            top--; // Discard '('
        } else {
            // Pop higher/equal priority operators
            while (top != -1 && prec(stack[top]) >= prec(ch)) 
                printf("%c", stack[top--]);
            stack[++top] = ch; // Push current operator
        }
    }

    // Clear remaining operators in stack
    while (top != -1) 
        printf("%c", stack[top--]);
        
    printf("\n");
    return 0;
}
