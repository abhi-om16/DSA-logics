#include <stdio.h>

int main() {
    int i, j, n, temp;
    
    printf("Enter size of array: ");
    scanf("%d", &n);
    
    int a[n];
    printf("Enter elements of array: ");
    for(i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    // 1. Sort the array in ascending order (Bubble Sort)
    for(i = 0; i < n - 1; i++) {
        for(j = 0; j < n - i - 1; j++) {
            if(a[j] > a[j + 1]) {
                temp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = temp;
            }
        }
    }

    // 2. Calculate and print the median
    if(n % 2 == 0) {
        // For even elements, average the two middle values
        float median = (a[n / 2 - 1] + a[n / 2]) / 2.0;
        printf("Median: %.2f\n", median);
    } else {
        // For odd elements, take the exact middle value
        printf("Median: %d\n", a[n / 2]);
    }

    return 0;
}
