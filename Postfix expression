#include <stdio.h>
#include <ctype.h>
#include <math.h>

#define MAX 100

int stack[MAX];
int top = -1;

/* Push an element into the stack */
void push(int x)
{
    stack[++top] = x;
}

/* Pop an element from the stack */
int pop()
{
    return stack[top--];
}

int main()
{
    char exp[MAX];
    int i, a, b, result;

    printf("Enter postfix expression: ");
    scanf("%s", exp);

    /* Scan the postfix expression */
    for (i = 0; exp[i] != '\0'; i++)
    {
        /* If operand, push it onto the stack */
        if (isdigit(exp[i]))
        {
            push(exp[i] - '0');
        }
        else
        {
            /* Pop two operands */
            b = pop();
            a = pop();

            /* Perform the operation */
            switch (exp[i])
            {
                case '+':
                    result = a + b;
                    break;

                case '-':
                    result = a - b;
                    break;

                case '*':
                    result = a * b;
                    break;

                case '/':
                    result = a / b;
                    break;

                case '%':
                    result = a % b;
                    break;

                case '^':
                    result = (int)pow(a, b);
                    break;

                default:
                    printf("Invalid operator\n");
                    return 1;
            }

            /* Push the result back onto the stack */
            push(result);
        }
    }

    printf("Result = %d\n", pop());

    return 0;
}
