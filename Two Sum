#include <stdio.h>
int main() {
    int i,j,n;
    printf("Enter size of element: ");
    scanf("%d",&n);
    int a[n];
    printf("Enter elements of array: ");
    for(i=0;i<n;i++){
        scanf("%d",&a[i]);
    }
    int target;
    printf("Enter target: ");
    scanf("%d",&target);
    int found = 0;
    for(i=0;i<n;i++){
        for(j=i+1;j<n;j++){
            if(a[i] + a[j] == target){
                printf("[%d, %d]\n", i, j);
                found = 1;
                break;
            }
        }
            if(found){
        break;
    }
    }
    if(!found){
        printf("Target does not match");
    }
    return 0;
}
