#include <iostream>
#include <vector>
using namespace std;
int main() 
{
    int n,target,count=0;
    cout << "Enter elements of array: ";
    cin >> n;
    vector<int> a(n);
    for(int i=0;i<n;i++){
        cin >> a[i];
    }
    cout << "Enter target ";
    cin >> target;
    for(int i=0;i<n;i++){
        if(a[i] == target){
            count += 1;
        }
    }
    cout << count;
    return 0;
}
