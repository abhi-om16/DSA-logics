#include <iostream>
using namespace std;
// upto integer 1023
int main() 
{
    int decimal;
    cout << "Enter a decimal number: ";
    cin >> decimal;
    int ans = 0,rem = 0,pow = 1;
    while(decimal > 0){
        rem = decimal % 2;
        decimal /= 2;
        ans += rem * pow;
        pow *= 10;
    }
    cout <<"Binary: " <<ans;
    return 0;
}
