class Solution {
public:
    int missingNumber(vector<int>& nums) {
        int n = nums.size();
        int actualSum = 0;
        int totalSum = 0;
        for(int i=0;i<n;i++){
            actualSum += nums[i];
        }
        totalSum = (n*(n+1))/2;
        return totalSum - actualSum;
    }
};
