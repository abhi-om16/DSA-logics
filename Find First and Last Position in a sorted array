class Solution {
public:
    vector<int> searchRange(vector<int>& nums, int target) {
        int n = nums.size();
        for(int i = 0;i < n;i++){
            if(nums[i] == target){
                int var1 = i;
                for(int j=i+1;j<n;j++){
                    if(nums[i] == target){
                        int var2 = j;
                    }
                }
            }
        }
        return [var1,var2];
    }
};
