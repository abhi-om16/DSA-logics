class Solution {
public:
    int addDigits(int num) {
    vector<int> digits;
    if(num == 0){
        return 0;
    }
    while(num > 0){
        int rem = num % 10;
        digits.push_back(rem);
        num /= 10;
    }
    int sum = 0;
    for(int i=0;i<digits.size();i++){
         sum += digits[i];
        if(sum < 10){
            return sum;
        }
    }
    }
};
