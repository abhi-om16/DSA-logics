    #include <stdio.h>
    int main() {
    int m,n,sum=0;
        printf("Enter m and n: ");
        scanf("%d%d",&m,&n);
        if(m > n){
            int temp = m;
            m = n;
            n = temp;
        }
        for(int i=m;i<=n;i++){
            if(i % 15 == 0){
                sum += i;
            }
        }
        printf("SUM: %d",sum);
        return 0;
    }
